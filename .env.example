# =============================================================================
# API Keys — uncomment only the providers you use
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GOOGLE_API_KEY=...

# Mistral
# MISTRAL_API_KEY=...

# Ollama — no key needed (runs locally)


# =============================================================================
# Model configuration — format: provider/model-name
# =============================================================================
# If an agent-specific var is not set, DEFAULT_MODEL is used.
# If DEFAULT_MODEL is not set, falls back to openai/gpt-4o.

DEFAULT_MODEL=openai/gpt-4o

# --- Per-agent overrides (uncomment and edit to customize) ---

# COORDINATOR_MODEL=openai/gpt-4o
# INBOX_SCANNER_MODEL=openai/gpt-4o-mini
# THREAD_RESEARCHER_MODEL=openai/gpt-4o-mini
# SENDER_PROFILER_MODEL=openai/gpt-4o-mini
# COMPOSER_MODEL=anthropic/claude-opus-4-6
# REVIEWER_MODEL=anthropic/claude-sonnet-4-6

# --- Example: full Anthropic setup ---
# DEFAULT_MODEL=anthropic/claude-sonnet-4-6
# COMPOSER_MODEL=anthropic/claude-opus-4-6

# --- Example: mix of providers ---
# COORDINATOR_MODEL=openai/gpt-4o          # strong reasoning for routing
# COMPOSER_MODEL=anthropic/claude-opus-4-6 # best writing quality
# REVIEWER_MODEL=openai/gpt-4o-mini        # cheap for review pass
# INBOX_SCANNER_MODEL=google/gemini-2.0-flash  # fast for scanning

# --- Example: fully local with Ollama ---
# DEFAULT_MODEL=ollama/llama3.1
# COMPOSER_MODEL=ollama/mistral-nemo

